  "definition": {
    "resource": [
      {
        "reference": {
          "reference": "ValueSet/sct"
        },
        "name": "CH IG SNOMED CT",
        "description": "Example value set including SNOMED CT codes from the international and the Swiss edition.",
        "exampleBoolean": false
      },
      {
        "reference": {
          "reference": "Questionnaire/QuestionnaireItemControlDropDown"
        },
        "name": "itemControl drop-down (control)",
        "description": "Control: the itemControl code drop-down is in the R4 core questionnaire-item-control code system (4.0.1), and validates without an issue.",
        "exampleBoolean": true
      },
      {
        "reference": {
          "reference": "Questionnaire/QuestionnaireItemControlTabContainer"
        },
        "name": "itemControl tab-container",
        "description": "The itemControl code tab-container is defined in the questionnaire-item-control code system of the FHIR Extensions pack, but not in the R4 core copy (4.0.1) the validator resolves: Unknown code 'tab-container'.",
        "exampleBoolean": true
      },
      {
        "reference": {
          "reference": "Questionnaire/QuestionnaireItemControlTabContainerVersioned"
        },
        "name": "itemControl tab-container, coding pinned to the Extensions pack version",
        "description": "The same as QuestionnaireItemControlTabContainer, with the coding pinned to version 5.3.0 of the code system (the FHIR Extensions pack version the IG Publisher loads). This validates without an issue.",
        "exampleBoolean": true
      },
      {
        "reference": {
          "reference": "Questionnaire/QuestionnaireItemControlTabContainerVersionedSdc"
        },
        "name": "itemControl tab-container, coding pinned to the Extensions pack version, SDC profile",
        "description": "The same as QuestionnaireItemControlTabContainerVersioned, but the Questionnaire claims an SDC profile (as SDC forms do). Validating against the SDC profile brings the R4 core value set 4.0.1 back, and with it a code system version mismatch.",
        "exampleBoolean": true
      },
      {
        "reference": {
          "reference": "Patient/example"
        },
        "name": "Petra Meier",
        "description": "Example for CH Core Patient.",
        "exampleBoolean": true
      }
    ],
